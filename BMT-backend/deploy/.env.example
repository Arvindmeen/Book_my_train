# Copy to deploy/.env on the server. Never commit deploy/.env.
NODE_ENV=production
LOG_LEVEL=info
API_DOMAIN=api.example.com

POSTGRES_PASSWORD=replace-with-a-long-random-password
REDIS_PASSWORD=replace-with-a-long-random-password

# CORS and browser URLs
ALLOWED_ORIGINS=https://your-vercel-project.vercel.app
FRONTEND_URL=https://your-vercel-project.vercel.app/login
COOKIE_SAME_SITE=none

# Authentication and internal service trust
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-64
OTP_HMAC_SECRET=replace-with-openssl-rand-hex-32
INTERNAL_SERVICE_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXP=15m
REFRESH_TOKEN_EXP=7d
ACCESS_TOKEN_EXP_SEC=900
REFRESH_TOKEN_EXP_SEC=604800
OTP_TTL=300
OTP_RATE_MAX_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
REDIS_USER_TTL=86400

# Kafka clients
KAFKA_CLIENT_ID=bmt-production

# Email provider: use a verified sender with SendGrid or SMTP values expected by the service
EMAIL_USER=verified-sender@example.com
EMAIL_PASS=replace-with-email-provider-password-or-token
SUPPORT_EMAIL=support@example.com

# Google OAuth, optional
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Razorpay, required for payment flows
PAYMENT_GATEWAY=razorpay
RAZORPAY_KEY_ID=replace-with-test-or-live-key
RAZORPAY_KEY_SECRET=replace-with-test-or-live-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret

# Rate limiting and downstream timeouts
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SERVICE_TIMEOUT_MS=60000
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=60000
BOOKING_TTL_SECONDS=600
LOCK_TTL_SECONDS=600
BOOKING_EXPIRY_CHECK_INTERVAL_MS=30000
LOCK_EXPIRY_INTERVAL_MS=60000

# Do not set true after the initial search index bootstrap
ES_RECREATE_INDICES=false
