{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start All Services",
      "dependsOn": [
        "api-gateway",
        "user-service",
        "search-service",
        "admin-service",
        "notification-service",
        "booking-service",
        "payment-service",
        "inventory-service"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "api-gateway",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/api-gateway"
